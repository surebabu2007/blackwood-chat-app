# API Configuration (public values only)
NEXT_PUBLIC_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash-latest:generateContent

# Secure AI Provider Credentials (keep these out of version control)
# Primary key used by server-side route (supports Google, Anthropic, etc.)
AI_SERVICE_API_KEY=
# Optional: override base URL or custom auth header name if provider requires it
AI_SERVICE_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash-latest:generateContent
AI_SERVICE_AUTH_HEADER=

# Optional compatibility variable for legacy setups (not recommended for production)
NEXT_PUBLIC_API_TOKEN=

# If you're using Google APIs, you can also supply the same key here.
# The app will prefer AI_SERVICE_API_KEY when both are present.
GOOGLE_API_KEY=

# Game Configuration
NEXT_PUBLIC_GAME_TITLE=Blackwood Manor Investigation
NEXT_PUBLIC_DETECTIVE_NAME=Detective Sarah Chen

# Development
NODE_ENV=development